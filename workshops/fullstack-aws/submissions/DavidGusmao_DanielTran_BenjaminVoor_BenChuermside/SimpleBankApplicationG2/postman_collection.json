                "login"
              ]
            },
            "description": "Expect 401. The message is identical to an unknown email, so the form cannot be used to discover which addresses are registered.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"not-the-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Store the token so every other request in this collection can use it.",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "    pm.collectionVariables.set(\"token\", body.token);",
                  "    console.log(\"token stored for \" + body.user.email + \" (\" + body.user.role + \")\");",
                  "}",
                  "pm.test(\"login succeeded\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
