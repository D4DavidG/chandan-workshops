                "deposit"
              ]
            },
            "description": "Run the Deposit request first, then this. Expect 409: the double-clicked submit button does not deposit twice.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000,\n  \"clientTxnId\": \"postman-deposit-0001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
