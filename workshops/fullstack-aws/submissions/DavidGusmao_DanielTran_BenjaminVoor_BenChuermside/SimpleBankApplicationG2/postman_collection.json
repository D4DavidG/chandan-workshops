    {
      "name": "Failure cases",
      "item": [
        {
          "name": "Overdraft is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{lowBalanceAccountId}}/withdraw",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{lowBalanceAccountId}}",
                "withdraw"
              ]
            },
            "description": "Account 6 holds 12.50. Expect 409 and an unchanged balance.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1251\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Negative amount is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{accountId}}",
                "deposit"
              ]
            },
            "description": "Expect 400, rejected by validation before anything is written.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": -5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "A dollars-and-cents string is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{accountId}}",
                "deposit"
              ]
            },
            "description": "Expect 400. This API takes a whole number of cents, so 10.50 dollars is sent as 1050. A quoted \"10.50\" is what the previous version of this API accepted, and it is refused rather than guessed at.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"10.50\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "A fractional JSON number is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{accountId}}",
                "deposit"
              ]
            },
            "description": "Expect 400. `10.50` parses to a float, which has already lost precision by the time the server sees it, and is ambiguous besides: in an API that speaks cents it could mean ten and a half cents. Send 1050.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Frozen account refuses a deposit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{frozenAccountId}}/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{frozenAccountId}}",
                "deposit"
              ]
            },
            "description": "Account 10 is seeded FROZEN. Expect 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Duplicate clientTxnId is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/deposit",
              "host": [
